# Copy to config.env (gitignored). Public material only.

# Project holding the keeper service. Must differ from the key project.
KEEPER_PROJECT=

# Cloud Run and Cloud Scheduler region.
REGION=us-central1

# Cloud Run job; the Cloud Scheduler job and the alert policy share the name.
JOB=hydrex-keeper

# Service account names in KEEPER_PROJECT: the job's identity, and the one
# Cloud Scheduler uses to start it.
KEEPER_SA_NAME=hydrex-keeper
SCHEDULER_SA_NAME=hydrex-keeper-scheduler

# Signing key version: `version` in hydrex-keeper-key's record/keeper.json.
KMS_KEY_VERSION=

# KlimaVeTokenConduitExecutor on Base.
MODULE=0x750973E0CB728C3112561Bc8E9b235afA9B17E81

# Seconds before the epoch flip (Thursday 00:00 UTC) at which the job evaluates
# the vote, re-voting if the best pool changed.
VOTE_OFFSETS=3600,600,60

# When Cloud Scheduler starts the job, UTC cron. Must precede the first offset.
SCHEDULE="50 22 * * 3"

# Secret Manager secret holding the Base RPC URL.
RPC_SECRET=base-rpc-url

# Receives an email when an execution fails.
ALERT_EMAIL=
