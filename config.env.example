# Copy to config.env. Public values only.

# Project for the job. Must not be the key's project.
KEEPER_PROJECT=

# Cloud Run and Cloud Scheduler region.
REGION=us-central1

# Cloud Run job. Also names the scheduler jobs ($JOB-1, $JOB-2, ...) and the alert ("$JOB failed").
JOB=hydrex-keeper

# Service accounts that run the job and start it.
KEEPER_SA_NAME=hydrex-keeper
SCHEDULER_SA_NAME=hydrex-keeper-scheduler

# Signing key: `version` in hydrex-keeper-key's record/keeper.json.
KMS_KEY_VERSION=

# KlimaVeTokenConduitExecutor on Base.
MODULE=0x750973E0CB728C3112561Bc8E9b235afA9B17E81

# Seconds before the epoch flip (Thursday 00:00 UTC) at which the job runs a pass.
VOTE_OFFSETS=86400,600,200,70,25,10,5

# When Cloud Scheduler starts the job: "M H * * D" in UTC, separated by ";". An execution runs the passes due in the
# next hour, so each VOTE_OFFSETS entry must fall in the hour after one of these. The scripts check this.
SCHEDULES="50 23 * * 2;40 23 * * 3"

# Secret Manager secret holding the Base RPC URL, or several separated by commas.
RPC_SECRET=base-rpc-url

# Gets an email when an execution fails.
ALERT_EMAIL=
